# Enable mock mode to run the frontend without an AWS backend (true/false)
NEXT_PUBLIC_MOCK_MODE=true

# API Gateway URL — find in CloudFormation stack outputs: "ApiUrl" from BackendStack
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/v1

# Cognito User Pool ID — find in CloudFormation stack outputs: "UserPoolId" from AuthStack
NEXT_PUBLIC_USER_POOL_ID=us-east-1_xxxxxxxxx

# Cognito User Pool Client ID — find in CloudFormation stack outputs: "UserPoolClientId" from AuthStack
NEXT_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Region where the stacks are deployed
NEXT_PUBLIC_REGION=us-east-1

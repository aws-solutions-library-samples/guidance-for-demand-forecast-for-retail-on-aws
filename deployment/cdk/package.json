{
  "name": "retail-forecast-cdk",
  "version": "1.0.0",
  "description": "CDK infrastructure for Demand Forecasting PoC",
  "bin": {
    "app": "bin/app.ts"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
